{
  "expo": {
    "name": "hermes-mobile-app",
    "slug": "hermes-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hermesmobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/hermes-agent.icon",
      "bundleIdentifier": "com.dintinoconte.hermesmobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "appleTeamId": "YRJ252E8T3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dintinoconte.hermesmobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Hermes scans the pairing QR code shown by 'hermes mobile pair' to connect to your gateway."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hermes attaches photos you choose to your messages.",
          "cameraPermission": "Hermes lets you photograph something and send it to your agent."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1318a166-de42-4f1f-a5e4-2f4c86490c3f"
      }
    },
    "owner": "gldcio"
  }
}
